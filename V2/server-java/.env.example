# Copia este fichero a server-java/.env (está en .gitignore) y rellena la contraseña.
# Supabase → botón "Connect" → pestaña JDBC.

# OJO con el puerto: usa el 5432 (pooler en modo sesión), NO el 6543 (modo transacción).
# Flyway y las prepared statements de Hibernate no funcionan bien contra PgBouncer en
# modo transacción; el backend Node usaba el 6543 porque Prisma sí lo tolera.
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-eu-west-1.pooler.supabase.com:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres.PROJECT_REF
SPRING_DATASOURCE_PASSWORD=

# Secreto para firmar los JWT de sesión (una cadena larga y aleatoria).
# No hace falta que coincida con el del backend Node: el claim del id cambió
# (userId → sub), así que las sesiones viejas caducan igual.
JWT_SECRET=

# Puerto del backend y origen permitido para CORS (Vite sirve el front en 5173).
PORT=3001
CORS_ORIGIN=http://localhost:5173
