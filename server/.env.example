# Supabase → botón "Connect" → pestaña ORM/Prisma.
# DATABASE_URL: pooler en modo transacción (6543), la usa la app en cada petición.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: pooler en modo sesión (5432), la usa Prisma solo para migraciones.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Secreto para firmar los JWT de sesión (genera uno propio, no uses este de ejemplo)
JWT_SECRET="cambia-esto-por-una-cadena-larga-aleatoria"

# Puerto del servidor Fastify
PORT=3001

# Origen permitido para CORS (frontend en Vercel; en local, http://localhost:5173)
CORS_ORIGIN="http://localhost:5173"
